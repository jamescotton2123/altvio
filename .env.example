# Supabase project URL used by core.database to create the API client.
SUPABASE_URL=YOUR_VALUE_HERE

# Supabase service_role key (Settings → API). Required for ops routes that read kyc_reviews.
# Do not use the anon key here — kyc_reviews may lack anon grants and RLS will block reads.
SUPABASE_KEY=YOUR_VALUE_HERE

# OpenAI API key used by parsers, natural-language query routing, wire extraction, and OpenAI vision review.
OPENAI_API_KEY=YOUR_VALUE_HERE

# Anthropic API key used by the Claude KYC review engine.
ANTHROPIC_API_KEY=YOUR_VALUE_HERE

# Microsoft Azure tenant ID used for Microsoft Graph authentication.
AZURE_TENANT_ID=YOUR_VALUE_HERE

# Microsoft Azure app client ID used for Microsoft Graph authentication.
AZURE_CLIENT_ID=YOUR_VALUE_HERE

# Microsoft Azure app client secret used for Microsoft Graph authentication.
AZURE_CLIENT_SECRET=YOUR_VALUE_HERE

# SharePoint site ID where KYC folders and documents are managed.
SHAREPOINT_SITE_ID=YOUR_VALUE_HERE

# SharePoint drive ID containing the KYC document library.
SHAREPOINT_DRIVE_ID=YOUR_VALUE_HERE

# SharePoint parent folder for KYC document provisioning.
SHAREPOINT_KYC_ROOT=YOUR_VALUE_HERE

# Operations mailbox used for follow-up emails and Graph email workflows.
OPS_MAILBOX=YOUR_VALUE_HERE

# Public HTTPS URL of this API (required for Microsoft Graph mail webhooks).
# Local dev: use an ngrok URL, e.g. https://abc123.ngrok-free.app — localhost will not work for Graph.
API_PUBLIC_BASE_URL=YOUR_VALUE_HERE

# Public platform URL used when generating follow-up links.
PLATFORM_BASE_URL=YOUR_VALUE_HERE

# Public investor portal URL used when generating portal links.
PORTAL_BASE_URL=YOUR_VALUE_HERE

# DocuSign integration key used for JWT authentication.
DOCUSIGN_INTEGRATION_KEY=YOUR_VALUE_HERE

# DocuSign account ID used for API calls and envelope dispatch.
DOCUSIGN_ACCOUNT_ID=YOUR_VALUE_HERE

# DocuSign user ID used for JWT impersonation.
DOCUSIGN_USER_ID=YOUR_VALUE_HERE

# DocuSign RSA private key used for JWT authentication; keep newline escaping compatible with deployment tooling.
DOCUSIGN_PRIVATE_KEY=YOUR_VALUE_HERE

# DocuSign REST API base path for the target account environment.
DOCUSIGN_BASE_PATH=YOUR_VALUE_HERE

# DocuSign template ID for subscription document envelopes.
DOCUSIGN_SUB_DOC_TEMPLATE_ID=YOUR_VALUE_HERE

# DocuSign template ID for advisory agreement envelopes.
DOCUSIGN_ADVISORY_TEMPLATE_ID=YOUR_VALUE_HERE

# DocuSign template ID for letter-of-intent envelopes.
DOCUSIGN_LOI_TEMPLATE_ID=YOUR_VALUE_HERE

# DocuSign template ID for transfer-of-interest envelopes.
DOCUSIGN_TOI_TEMPLATE_ID=YOUR_VALUE_HERE
